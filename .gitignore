# ================================
# .NET / C# baseline
# ================================
# User/IDE state
*.user
*.suo
*.userprefs
*.sln.ide
*.DotSettings.user

# ReSharper
_ReSharper.*

# NuGet (keep .nuget config, ignore local packages cache)
.nuget/packages/
packages/

# OS junk
.DS_Store
Thumbs.db

# Logs
*.log
[Ll]og/
[Ll]ogs/

# Build outputs (scoped)
**/[Bb]in/
**/[Oo]bj/
artifacts/
out/
TestResults/

# .NET Core lock files (legacy)
project.lock.json
project.fragment.lock.json

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg

# Code coverage & test artifacts
CodeCoverage/
*.coverage
*.coveragexml
*.opencover.xml
*.trx

# MSBuild Binary and Structured Log
*.binlog

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Temp files
~$*
*~

# ================================
# IDEs / Editors
# ================================
# Visual Studio
.vs/

# VS caches & layout (don’t commit)
**/DesignTimeBuild/
**/.dbcache*/
**/FileContentIndex/
**/v*/DocumentLayout*.json

# VS Code / JetBrains
.vscode/
.idea/
.rider/
*.code-workspace

